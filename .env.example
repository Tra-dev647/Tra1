# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin authentication
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-this-password"

# Bakong Open API (secrets stay server-side; never commit .env.local)
BAKONG_API_BASE_URL="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN=""
BAKONG_ACCOUNT_ID=""
BAKONG_MERCHANT_NAME="TRATOPUP"
MERCHANT_CITY="Tboung Khmum"

# Khmer Topup reseller API (server-side only)
KHMER_TOPUP_API_URL="https://khmer-topup.com/api/v1"
KHMER_TOPUP_API_KEY=""

# Store settings
PAYMENT_CURRENCY="USD"
PAYMENT_SIMULATION_MODE="false"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PUBLIC_APP_URL=""
