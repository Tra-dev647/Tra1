# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin authentication
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-this-password"

# Bakong Open API (secrets stay server-side; never commit .env.local)
BAKONG_API_BASE_URL="https://api-bakong.nbc.gov.kh"
BAKONG_API_TOKEN=""
BAKONG_ACCOUNT_ID=""
BAKONG_MERCHANT_NAME="TRATOPUP"
MERCHANT_CITY="Tboung Khmum"

# Khmer Topup reseller API (server-side only)
KHMER_TOPUP_API_URL="https://khmer-topup.com/api/v1"
KHMER_TOPUP_API_KEY=""

# Store settings
PAYMENT_CURRENCY="USD"
PAYMENT_SIMULATION_MODE="false"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
PUBLIC_APP_URL=""

# Rate limiting (recommended on Vercel — free tier at upstash.com; falls back to in-memory if blank)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Image uploads on Vercel (Storage -> Create Blob store; token is added automatically)
BLOB_READ_WRITE_TOKEN=""

# Telegram SHOP bot (customers buy inside Telegram). Create with @BotFather.
# Separate from the admin-notification bot configured in Admin -> Settings.
TELEGRAM_SHOP_BOT_TOKEN=""
# Any random string, 16+ chars (A-Z a-z 0-9 _ -). Telegram sends it back on every webhook call.
TELEGRAM_WEBHOOK_SECRET=""
